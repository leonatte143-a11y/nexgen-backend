# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nexgen
DB_USER=root
DB_PASS=
# Optional alias for DB_PASS (either works):
# DB_PASSWORD=

# Server
PORT=4000
NODE_ENV=development
HOST=0.0.0.0

# Auth — generate strong random strings for production (never commit real secrets)
# Option A (recommended): separate signing keys per role
JWT_USER_SECRET=change_me_user_jwt
JWT_PARTNER_SECRET=change_me_partner_jwt
JWT_ADMIN_SECRET=change_me_admin_jwt
# Option B: single shared key used when a role-specific secret is empty
# JWT_SECRET=change_me_shared_jwt_fallback
JWT_EXPIRES_IN=7d

# OTP (DB-backed; integrate SMS in production)
OTP_DIGITS=6
OTP_MAX_REQUESTS_PER_15M=5
OTP_MAX_VERIFY_ATTEMPTS=5
# NEVER enable in production — returns plaintext OTP in JSON and logs it (local Expo only)
OTP_DEBUG_RESPONSE=true

ADMIN_SEED_EMAIL=admin@nexgen.local
ADMIN_SEED_PASSWORD=ChangeMe123!
