# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nexgen
DB_USER=root
DB_PASS=
# Optional alias for DB_PASS (either works):
# DB_PASSWORD=

# NOTE: We include both DB_PASS and DB_PASSWORD because different environments
# might use either name. The application will use whichever is set.

# Server
PORT=4000
NODE_ENV=development
HOST=0.0.0.0
# Staging: comma-separated admin + Expo web origins (omit = allow all — dev only)
# CORS_ORIGIN=https://your-admin.vercel.app,http://localhost:5173
# NEVER enable on shared servers — auto-alters schema unpredictably
DB_SYNC=false
# Verbose SQL/request logs (never true in production)
API_DEBUG=false

# Auth — generate strong random strings for production (never commit real secrets)
# Option A (recommended): separate signing keys per role
JWT_USER_SECRET=change_me_user_jwt
JWT_PARTNER_SECRET=change_me_partner_jwt
JWT_ADMIN_SECRET=change_me_admin_jwt
# Option B: single shared key used when a role-specific secret is empty
# JWT_SECRET=change_me_shared_jwt_fallback
JWT_EXPIRES_IN=7d

# OTP (DB-backed; integrate SMS in production)
OTP_DIGITS=6
OTP_MAX_REQUESTS_PER_15M=5
OTP_MAX_VERIFY_ATTEMPTS=5
# NEVER enable in production — returns plaintext OTP in JSON and logs it (local Expo only)
OTP_DEBUG_RESPONSE=false

ADMIN_SEED_EMAIL=admin@nexgen.local
ADMIN_SEED_PASSWORD=ChangeMe123!

#------------------------------------------------------------
# Notes:
# - Local development: copy this file to `.env` and edit values:
#     cp .env.example .env
#   The server will load `.env` when `NODE_ENV` is not production.
# - Railway / Hosted platforms: do NOT copy `.env` into the container. Instead
#   set the variables in the Railway Variables panel (they are injected into
#   process.env automatically at runtime). The app detects Railway and will
#   use platform env vars.
# - Never commit real secrets to source control. Keep `.env` listed in .gitignore.
#------------------------------------------------------------
