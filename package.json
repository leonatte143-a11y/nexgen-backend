{
  "name": "nexgen-api",
  "version": "1.0.0",
  "private": true,
  "description": "NEXGEN backend (Express, MySQL, Sequelize) — built from mobile mock service contracts",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "NODE_ENV=production node src/index.js",
    "start:win": "set NODE_ENV=production&& node src/index.js",
    "db:sync": "node src/scripts/syncDb.js",
    "db:migrate": "node src/scripts/migrate.js",
    "db:cleanup-indexes": "node src/scripts/cleanupDuplicateIndexes.js",
    "db:seed": "node src/scripts/seed.js",
    "db:setup": "npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.11.0",
    "sequelize": "^6.37.3",
    "uuid": "^10.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
